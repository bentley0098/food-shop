# Copy to .env and fill in. Local values come from `supabase status` after
# `supabase start` — never point .env at the production project.
# See INFRASTRUCTURE.md §5.

# Project endpoint. Read by @nuxtjs/supabase — do not rename.
SUPABASE_URL=http://127.0.0.1:54321

# Anon key. Safe to expose to the browser; RLS is what protects the data.
SUPABASE_KEY=

# Service-role key. Bypasses RLS entirely — server-only, never NUXT_PUBLIC_*,
# never referenced outside server/. See INFRASTRUCTURE.md §5.3.
SUPABASE_SERVICE_KEY=

# Open Food Facts asks for a descriptive User-Agent (SPEC.md §5).
OFF_USER_AGENT=HouseholdMeals/0.1 (contact@example.com)

# Absolute site URL, used to build invite links (SPEC.md §2).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client, for local Supabase auth (see supabase/config.toml,
# INFRASTRUCTURE.md §9.1). Same client as production; only the redirect
# URIs differ.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
